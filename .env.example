# Copy to .env.local for development, and set the same values as
# Environment Variables on the Vercel project for deployment.

# The shared password team members type in at /team/login.
TEAM_PORTAL_PASSWORD=

# Random secret used to sign team-portal session cookies. Generate one with:
#   openssl rand -hex 32
TEAM_PORTAL_SECRET=

# Redis (Upstash) store backing the team updates board. Created via the
# Vercel dashboard: Storage -> Create Database -> Redis (Upstash), then
# "Connect" it to this project — Vercel injects these two automatically.
# For local dev, run `vercel env pull .env.local` after connecting, or
# copy the values from the store's "Quickstart" / ".env.local" tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
